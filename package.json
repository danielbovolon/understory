{
  "name": "understory",
  "version": "5.1.0",
  "description": "A mycorrhizal sound forest for the browser (Web Audio + AudioWorklet): trees, fungi, signals, sugar and spores in binaural 3D.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes http-server -c-1 -p 8080 .",
    "build": "node tools/build-standalone.mjs",
    "test": "node tools/stress-test.mjs 20",
    "test:sim": "node tools/sim-test.mjs --minutes 60",
    "test:scale": "node tools/scale-test.mjs",
    "test:events": "node tools/events-test.mjs",
    "test:mix": "node tools/mix-test.mjs MOSS77 120",
    "test:longrun": "node tools/longrun-test.mjs",
    "test:away": "node tools/away-test.mjs",
    "test:layers": "node tools/layer-test.mjs",
    "test:evolve": "node tools/evolve-test.mjs"
  },
  "author": "Daniel Bovolon",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
